# ============================================================================
# Environment Variables Template
# ============================================================================
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and will not be committed.
#
# Usage:
#   cp .env.example .env.local
#   # Then edit .env.local with your actual values
#
# ============================================================================
# Public Environment Variables (exposed to browser)
# ============================================================================
# These variables are prefixed with NEXT_PUBLIC_ and are available in both
# Server Components and Client Components (browser).
#
# ⚠️  WARNING: Never put sensitive data in NEXT_PUBLIC_ variables!
# ============================================================================

# Base URL for the API
# Use full URL for external APIs: https://api.example.com
# Use relative path for same-origin: /api
# Default: /api
NEXT_PUBLIC_API_URL=/api

# Application name
# Used for branding, page titles, etc.
# Default: Observatory
NEXT_PUBLIC_APP_NAME=Observatory

# Application version
# Used for debugging and version display
# Default: 0.1.0
NEXT_PUBLIC_APP_VERSION=0.1.0

# Environment name
# Determines which environment we're running in
# Options: development | staging | production
# Default: development
NEXT_PUBLIC_ENV=development

# Enable debug mode
# Shows additional logging and debugging information
# Options: true | false | 1 | 0
# Default: false
NEXT_PUBLIC_DEBUG=false

# ============================================================================
# Private Environment Variables (server-only)
# ============================================================================
# These variables are ONLY available in Server Components and API routes.
# They are NEVER exposed to the browser.
#
# ✅ SAFE: Put sensitive data here (API keys, secrets, etc.)
# ============================================================================

# Database connection string
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/observatory
# Optional: Only required if using a database
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# NextAuth secret
# Used for encrypting JWT tokens and sessions
# Generate with: openssl rand -base64 32
# Required if using NextAuth
# NEXTAUTH_SECRET=your-secret-key-here-minimum-32-characters

# NextAuth URL
# Base URL of your application
# Example: https://example.com
# Required if using NextAuth
# NEXTAUTH_URL=http://localhost:3000

# API key for external services
# Example: Stripe, SendGrid, etc.
# Optional: Only required if using external services
# API_KEY=your-api-key-here

# Email service configuration
# SMTP server URL or service API key
# Optional: Only required if sending emails
# EMAIL_SERVICE_URL=smtp://smtp.example.com:587

# Redis connection string (if using Redis)
# Format: redis://host:port or redis://:password@host:port
# Optional: Only required if using Redis
# REDIS_URL=redis://localhost:6379

# Sentry DSN for error tracking
# Format: https://xxx@xxx.ingest.sentry.io/xxx
# Optional: Only required if using Sentry
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Logging level
# Options: debug | info | warn | error
# Default: info
LOG_LEVEL=info
